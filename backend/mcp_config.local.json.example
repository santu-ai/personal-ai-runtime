{
  "_comment": "Copy this file to mcp_config.local.json (gitignored) and edit. Entries in external_servers are merged on top of mcp_config.json by 'name'. Credentials come from .env, not this file.",
  "external_servers": [
    {
      "_comment": "TAPD (Tencent Agile Product Development) — read-only query tools. Requires TAPD_ACCESS_TOKEN in .env; server stays dormant until set. Get token at https://www.tapd.cn/company/my_tokens. Set TAPD_DEFAULT_WORKSPACE_ID and TAPD_NICK_NAME in .env to omit them per-call.",
      "name": "tapd",
      "type": "stdio",
      "enabled": true,
      "startup_connect": false,
      "command": "npx",
      "args": ["-y", "@xihe-lab/tapd-mcp-server@latest"],
      "required_env": ["TAPD_ACCESS_TOKEN"],
      "optional_env": ["TAPD_DEFAULT_WORKSPACE_ID", "TAPD_NICK_NAME"],
      "connect_timeout_seconds": 30,
      "policy_default": "auto_allow",
      "enabled_tools": [
        "tapd_get_stories",
        "tapd_get_story",
        "tapd_get_story_count",
        "tapd_get_story_categories",
        "tapd_get_story_changes",
        "tapd_get_bugs",
        "tapd_get_bug",
        "tapd_get_bug_count",
        "tapd_get_bug_changes",
        "tapd_get_tasks",
        "tapd_get_task",
        "tapd_get_task_changes",
        "tapd_get_iterations",
        "tapd_get_iteration",
        "tapd_get_timesheets",
        "tapd_get_timesheet_count",
        "tapd_get_comments",
        "tapd_get_current_user",
        "tapd_get_workitem_types",
        "tapd_get_story_fields",
        "tapd_get_bug_fields",
        "tapd_get_modules",
        "tapd_get_versions",
        "tapd_get_workflows",
        "tapd_parse_url"
      ],
      "ingestion_tools": [
        "tapd_get_stories",
        "tapd_get_story",
        "tapd_get_bugs",
        "tapd_get_bug",
        "tapd_get_tasks",
        "tapd_get_task",
        "tapd_get_iterations",
        "tapd_get_timesheets",
        "tapd_get_current_user"
      ]
    },
    {
      "_comment": "Tushare 金融数据 — A股/港美股/基金/宏观/财经新闻。需要 .env 里的 TUSHARE_TOKEN；未填时服务器保持 dormant。Token 申请：https://tushare.pro/register",
      "name": "tushare",
      "type": "stdio",
      "enabled": true,
      "startup_connect": false,
      "command": "npx",
      "args": ["-y", "aigroup-market-mcp@2.0.12"],
      "required_env": ["TUSHARE_TOKEN"],
      "connect_timeout_seconds": 30,
      "policy_default": "auto_allow",
      "enabled_tools": [
        "current_timestamp",
        "finance_news",
        "stock_data",
        "stock_data_minutes",
        "index_data",
        "macro_econ",
        "company_performance",
        "fund_data",
        "fund_manager_by_name",
        "convertible_bond",
        "block_trade",
        "money_flow",
        "margin_trade",
        "company_performance_us",
        "csi_index_constituents",
        "dragon_tiger_inst",
        "hot_news_7x24",
        "basic_info",
        "company_performance_hk"
      ],
      "ingestion_tools": [
        "finance_news",
        "stock_data",
        "stock_data_minutes",
        "index_data",
        "macro_econ",
        "company_performance",
        "fund_data",
        "company_performance_us",
        "company_performance_hk",
        "dragon_tiger_inst",
        "hot_news_7x24",
        "basic_info"
      ]
    }
  ]
}
